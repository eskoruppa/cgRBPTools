# scene settings
set bgColor white
lighting simple
graphics silhouettes true color black width 1.5
graphics quality 3.0

# load pdb
open 340_cg10.pdb
open 340_cg10.pdb

# set DNA visuals
style ball
nucleotides atoms
color white target a
color light gray target c
cartoon style nucleic xsect oval width 3.0 thick 1.2
hide #1 atoms
hide #2 cartoons

# load triads BILD
open 340_cg10_triads.bild

# Load spheres as markers (instanced atom spheres)
open 340_cg10_spheres.cmm
style #4 sphere
graphics quality atomTriangles 1000 totalAtomTriangles 34000
transparency #4 75 target a
